import pygame
import random
import sys

pygame.init()

# -------------------------
# تنظیمات
# -------------------------
WIDTH = 1000
HEIGHT = 400
FPS = 60

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Pixel Dino")

clock = pygame.time.Clock()

# رنگ‌ها
WHITE = (247, 247, 247)
BLACK = (40, 40, 40)
GRAY = (120, 120, 120)
GREEN = (55, 130, 65)

GROUND_Y = 320

# فونت
font = pygame.font.Font(None, 36)
big_font = pygame.font.Font(None, 70)


# -------------------------
# دایناسور
# -------------------------
class Dino:
    def __init__(self):
        self.x = 100
        self.y = GROUND_Y - 60
        self.width = 55
        self.height = 60

        self.velocity_y = 0
        self.gravity = 1.1
        self.jump_power = -17

        self.on_ground = True
        self.frame = 0
        self.animation_timer = 0

    def jump(self):
        if self.on_ground:
            self.velocity_y = self.jump_power
            self.on_ground = False

    def update(self):
        self.velocity_y += self.gravity
        self.y += self.velocity_y

        if self.y >= GROUND_Y - self.height:
            self.y = GROUND_Y - self.height
            self.velocity_y = 0
            self.on_ground = True

        self.animation_timer += 1

        if self.animation_timer >= 8:
            self.animation_timer = 0
            self.frame = 1 - self.frame

    def rect(self):
        return pygame.Rect(
            self.x + 5,
            self.y + 5,
            self.width - 10,
            self.height - 8
        )

    def draw(self):
        x = self.x
        y = self.y

        # بدن
        pygame.draw.rect(
            screen,
            BLACK,
            (x + 12, y + 15, 30, 32)
        )

        # سر
        pygame.draw.rect(
            screen,
            BLACK,
            (x + 25, y + 3, 28, 28)
        )

        # پوزه
        pygame.draw.rect(
            screen,
            BLACK,
            (x + 43, y + 17, 17, 13)
        )

        # دم
        pygame.draw.rect(
            screen,
            BLACK,
            (x + 2, y + 28, 18, 10)
        )

        pygame.draw.rect(
            screen,
            BLACK,
            (x - 4, y + 35, 18, 7)
        )

        # دست
        pygame.draw.rect(
            screen,
            BLACK,
            (x + 38, y + 32, 6, 18)
        )

        # چشم
        pygame.draw.rect(
            screen,
            WHITE,
            (x + 44, y + 8, 5, 5)
        )

        # پاها
        if self.on_ground:
            if self.frame == 0:
                pygame.draw.rect(
                    screen,
                    BLACK,
                    (x + 15, y + 43, 8, 18)
                )

                pygame.draw.rect(
                    screen,
                    BLACK,
                    (x + 35, y + 43, 8, 12)
                )

                pygame.draw.rect(
                    screen,
                    BLACK,
                    (x + 30, y + 53, 15, 6)
                )

            else:
                pygame.draw.rect(
                    screen,
                    BLACK,
                    (x + 15, y + 43, 8, 12)
                )

                pygame.draw.rect(
                    screen,
                    BLACK,
                    (x + 35, y + 43, 8, 18)
                )

                pygame.draw.rect(
                    screen,
                    BLACK,
                    (x + 10, y + 53, 15, 6)
                )
        else:
            pygame.draw.rect(
                screen,
                BLACK,
                (x + 15, y + 43, 8, 15)
            )

            pygame.draw.rect(
                screen,
                BLACK,
                (x + 35, y + 43, 8, 15)
            )


# -------------------------
# کاکتوس
# -------------------------
class Cactus:
    def __init__(self, x):
        self.x = x

        # چند نوع کاکتوس
        self.type = random.choice([0, 1, 2])

        if self.type == 0:
            self.width = 25
            self.height = 55

        elif self.type == 1:
            self.width = 45
            self.height = 55

        else:
            self.width = 60
            self.height = 60

        self.y = GROUND_Y - self.height

    def update(self, speed):
        self.x -= speed

    def rect(self):
        return pygame.Rect(
            self.x + 3,
            self.y + 3,
            self.width - 6,
            self.height - 3
        )

    def draw(self):
        x = int(self.x)
        y = self.y

        if self.type == 0:

            # تنه
            pygame.draw.rect(
                screen,
                GREEN,
                (x + 8, y, 12, self.height)
            )

            # بازوی راست
            pygame.draw.rect(
                screen,
                GREEN,
                (x + 18, y + 20, 10, 8)
            )

            pygame.draw.rect(
                screen,
                GREEN,
                (x + 20, y + 10, 8, 20)
            )

        elif self.type == 1:

            # تنه اصلی
            pygame.draw.rect(
                screen,
                GREEN,
                (x + 17, y, 13, self.height)
            )

            # بازوی چپ
            pygame.draw.rect(
                screen,
                GREEN,
                (x + 5, y + 25, 12, 8)
            )

            pygame.draw.rect(
                screen,
                GREEN,
                (x + 5, y + 15, 8, 20)
            )

            # بازوی راست
            pygame.draw.rect(
                screen,
                GREEN,
                (x + 30, y + 18, 12, 8)
            )

            pygame.draw.rect(
                screen,
                GREEN,
                (x + 34, y + 8, 8, 20)
            )

        else:

            # سه تنه کنار هم
            pygame.draw.rect(
                screen,
                GREEN,
                (x + 5, y + 10, 12, 50)
            )

            pygame.draw.rect(
                screen,
                GREEN,
                (x + 24, y, 13, 60)
            )

            pygame.draw.rect(
                screen,
                GREEN,
                (x + 43, y + 15, 12, 45)
            )

            # بازوها
            pygame.draw.rect(
                screen,
                GREEN,
                (x, y + 28, 10, 8)
            )

            pygame.draw.rect(
                screen,
                GREEN,
                (x + 48, y + 25, 12, 8)
            )


# -------------------------
# ابر
# -------------------------
class Cloud:
    def __init__(self, x):
        self.x = x
        self.y = random.randint(60, 140)
        self.speed = random.uniform(1, 2)

    def update(self):
        self.x -= self.speed

    def draw(self):
        color = (190, 190, 190)

        pygame.draw.rect(
            screen,
            color,
            (self.x, self.y + 10, 70, 10)
        )

        pygame.draw.rect(
            screen,
            color,
            (self.x + 15, self.y, 25, 20)
        )

        pygame.draw.rect(
            screen,
            color,
            (self.x + 35, self.y + 5, 25, 15)
        )


# -------------------------
# شروع بازی
# -------------------------
def reset_game():
    dino = Dino()

    cacti = [
        Cactus(WIDTH + 400)
    ]

    clouds = [
        Cloud(WIDTH + 100),
        Cloud(WIDTH + 500)
    ]

    score = 0
    speed = 7
    game_over = False

    return dino, cacti, clouds, score, speed, game_over


dino, cacti, clouds, score, speed, game_over = reset_game()


# -------------------------
# حلقه اصلی
# -------------------------
while True:

    clock.tick(FPS)

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_SPACE:
                if not game_over:
                    dino.jump()

            if event.key == pygame.K_r:
                if game_over:
                    dino, cacti, clouds, score, speed, game_over = reset_game()

    if not game_over:

        dino.update()

        # سرعت بازی
        speed = 7 + score // 500

        # کاکتوس‌ها
        for cactus in cacti:
            cactus.update(speed)

        # حذف کاکتوس خارج‌شده
        cacti = [
            cactus for cactus in cacti
            if cactus.x > -100
        ]

        # ساخت کاکتوس جدید
        if len(cacti) == 0 or cacti[-1].x < WIDTH - random.randint(300, 500):
            cacti.append(
                Cactus(WIDTH + random.randint(50, 200))
            )

        # ابرها
        for cloud in clouds:
            cloud.update()

        # برخورد
        for cactus in cacti:
            if dino.rect().colliderect(cactus.rect()):
                game_over = True

        # امتیاز
        score += 1

    # -------------------------
    # رسم
    # -------------------------
    screen.fill(WHITE)

    # ابرها
    for cloud in clouds:
        cloud.draw()

    # زمین
    pygame.draw.line(
        screen,
        BLACK,
        (0, GROUND_Y),
        (WIDTH, GROUND_Y),
        2
    )

    # دایناسور
    dino.draw()

    # کاکتوس‌ها
    for cactus in cacti:
        cactus.draw()

    # امتیاز
    score_text = font.render(
        f"SCORE: {score // 10:05d}",
        True,
        BLACK
    )

    screen.blit(
        score_text,
        (WIDTH - 230, 25)
    )

    # Game Over
    if game_over:

        text = big_font.render(
            "GAME OVER",
            True,
            BLACK
        )

        restart = font.render(
            "Press R to restart",
            True,
            BLACK
        )

        screen.blit(
            text,
            (
                WIDTH // 2 - text.get_width() // 2,
                120
            )
        )

        screen.blit(
            restart,
            (
                WIDTH // 2 - restart.get_width() // 2,
                195
            )
        )

    pygame.display.flip()
